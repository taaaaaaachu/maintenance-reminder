{
  "name": "maintenance-reminder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
    "build:shared": "pnpm --filter @maintenance-reminder/shared build",
    "deploy": "pnpm run build:frontend && pnpm --filter backend deploy",
    "typecheck": "pnpm --filter @maintenance-reminder/shared typecheck && pnpm --filter backend typecheck && pnpm --filter frontend typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter backend test && pnpm --filter frontend test"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.72.2"
  }
}
